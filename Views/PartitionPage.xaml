<UserControl x:Class="SystemMigrator.Views.PartitionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 分區列：整列可點，外觀自繪（與主頁的 RowCheckBoxStyle 同語意） -->
        <Style x:Key="PartitionRowStyle" TargetType="CheckBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CheckBoxBorder"
                                        Grid.Column="0"
                                        Width="16" Height="16"
                                        CornerRadius="4"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M 2,6 L 6,10 L 12,2"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="6,0,8,0"
                                                  VerticalAlignment="Center"/>

                                <TextBlock x:Name="SizeText"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#374151"
                                           Text="{Binding SizeText}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0F0FF"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左：磁碟與分區 ==================== -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="磁碟與分區" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnRefreshDisks"
                            Content="重新整理"
                            Width="82" Height="28"
                            HorizontalAlignment="Right"
                            Click="BtnRefreshDisks_Click"/>
                </DockPanel>

                <TextBlock x:Name="TxtDiskHint"
                           Grid.Row="1"
                           Style="{StaticResource HintText}"
                           Margin="0,0,0,8"
                           Text="正在讀取磁碟資訊..."/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DiskItems">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="#007ACC"/>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="0,2,0,0"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource PartitionRowStyle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="Row_Checked"
                                          Unchecked="Row_Unchecked"
                                          Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayLetter}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#2563EB"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       Margin="8,0,0,0"
                                                       Foreground="#111827"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding UsageText}"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       Foreground="#9CA3AF"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SubText}"
                                                   FontSize="10"
                                                   Foreground="#94A3B8"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtSelection" Text="尚未選擇分區" FontSize="11" TextWrapping="Wrap"
                               Foreground="#334155"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 右：操作面板 ==================== -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ① 備份 -->
                        <TextBlock Text="① 分區備份" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="RbWim" Content="完整映像（WIM）" IsChecked="True" Margin="0,0,16,0"/>
                            <RadioButton x:Name="RbFolder" Content="檔案級複製（Robocopy）"/>
                        </StackPanel>

                        <TextBlock Text="目標映像檔／資料夾" Style="{StaticResource HintText}" Margin="0,2,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtImagePath" Height="30" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="瀏覽..." Width="70" Height="30" Margin="8,0,0,0"
                                    Click="BtnBrowseImage_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="壓縮等級" VerticalAlignment="Center" FontSize="12" Foreground="#374151"/>
                            <ComboBox x:Name="CmbCompress" Width="120" Margin="8,0,16,0" SelectedIndex="0">
                                <ComboBoxItem Content="最大壓縮" Tag="max"/>
                                <ComboBoxItem Content="快速壓縮" Tag="fast"/>
                                <ComboBoxItem Content="不壓縮" Tag="none"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkIntegrity" Content="寫入校驗（較慢）" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="BtnBackup"
                                Content="開始備份所選分區"
                                Height="40"
                                Background="#28A745"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="BtnBackup_Click"
                                IsEnabled="False"/>

                        <TextBlock Text="⚠ 備份『執行中的系統分區』屬線上擷取，可能因檔案鎖定而不完整；正式遷移建議在 WinPE 離線執行。"
                                   Style="{StaticResource HintText}"
                                   Foreground="#B45309"
                                   Margin="0,8,0,0"/>

                        <Border Height="1" Background="#E5E7EB" Margin="0,14,0,14"/>

                        <!-- ② 安裝 / 還原 -->
                        <TextBlock Text="② 分區安裝 / 還原" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="映像索引（先用上方同一個 wim 檔）" Style="{StaticResource HintText}" Margin="0,2,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="CmbImageIndex" Width="120" SelectedIndex="0"/>
                            <Button x:Name="BtnReadImage" Content="讀取映像資訊" Width="110" Height="28" Margin="8,0,0,0"
                                    Click="BtnReadImage_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkFormat" Content="還原前快速格式化目標分區（會清空資料）" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkRepairBoot" Content="還原後重建 UEFI 引導（bcdboot）" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="ESP 分區" VerticalAlignment="Center" FontSize="12" Foreground="#374151"/>
                            <ComboBox x:Name="CmbEsp" Width="120" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="BtnApply"
                                Content="還原映像到所選分區"
                                Height="40"
                                Background="#D97706"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="BtnApply_Click"
                                IsEnabled="False"/>

                        <TextBlock Text="⚠ 還原會覆蓋目標分區的所有資料，且禁止對『執行中的系統分區』操作。"
                                   Style="{StaticResource HintText}"
                                   Foreground="#B91C1C"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 狀態 -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="{Binding Job.StatusText}" FontSize="12" Foreground="#374151"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnCancel" Content="取消" Width="60" Height="24" FontSize="11"
                                HorizontalAlignment="Right" IsEnabled="False" Click="BtnCancel_Click"/>
                    </DockPanel>
                    <ProgressBar x:Name="PbJob" Height="14" Maximum="100"
                                 Background="#E5E7EB" Foreground="#2563EB"
                                 Value="{Binding Job.Progress, Mode=OneWay}"/>
                </StackPanel>

                <!-- 日誌終端 -->
                <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Job.Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,1" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                                        <Run Foreground="#6A9955" Text="{Binding Time, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Message, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                            <Setter Property="Foreground" Value="#4EC9B0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="#888888"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
