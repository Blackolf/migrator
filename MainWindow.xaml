<Window x:Class="SystemMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SystemMigrator.Converters"
        Title="系統遷移與淨化大師 V1.0.2" Height="850" Width="1200" 
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    
    <Window.Resources>
        <conv:SelectedCountConverter x:Key="SelectedCountConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左側：掃描與選擇區 ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="1. 掃描與選擇" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnScan" Content="掃描系統" Width="100" Height="30" Background="#007ACC" Foreground="White" Click="BtnScan_Click" Margin="20,0,0,0"/>
                </StackPanel>
                
                <!-- 已安裝軟體列表 (修復多選：SelectionMode="Multiple") -->
                <ListBox x:Name="LstApps" Grid.Row="1" Margin="0,0,0,5" BorderThickness="1" BorderBrush="#E0E0E0" SelectionMode="Multiple">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#007ACC" FontSize="13"/>
                                                            <TextBlock Foreground="Gray" FontSize="12" Margin="5,0,0,0">
                                                                <Run Text="("/>
                                                                <Run Text="{Binding Items, Converter={StaticResource SelectedCountConverter}, Mode=OneWay}"/>
                                                                <Run Text="/"/>
                                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                                <Run Text=")"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <!-- 全選/全不選按鈕 -->
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <Button Content="全選" Width="50" Height="22" FontSize="11" Click="BtnSelectAllApps_Click" Margin="0,0,5,0"/>
                                                <Button Content="全不選" Width="50" Height="22" FontSize="11" Click="BtnSelectNoneApps_Click"/>
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="5,5"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0F0FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Text="數據備份/還原" FontWeight="SemiBold" Margin="0,5,0,5"/>
                
                <!-- 備份列表 (修復多選 + 優化大小顯示) -->
                <ListBox x:Name="LstBackups" Grid.Row="3" Margin="0,0,0,5" BorderThickness="1" BorderBrush="#E0E0E0" SelectionMode="Multiple">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#28A745" FontSize="13"/>
                                                            <TextBlock Foreground="Gray" FontSize="12" Margin="5,0,0,0">
                                                                <Run Text="("/>
                                                                <Run Text="{Binding Items, Converter={StaticResource SelectedCountConverter}, Mode=OneWay}"/>
                                                                <Run Text="/"/>
                                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                                <Run Text=")"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <Button Content="全選" Width="50" Height="22" FontSize="11" Click="BtnSelectAllBackups_Click" Margin="0,0,5,0"/>
                                                <Button Content="全不選" Width="50" Height="22" FontSize="11" Click="BtnSelectNoneBackups_Click"/>
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="5,5"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6F9EE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <!-- 優化大小顯示：Name (15.2 MB) -->
                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=" (" Foreground="Gray"/>
                                    <Run Text="{Binding SizeInMB, StringFormat={}{0:F1} MB, Mode=OneWay}" Foreground="#28A745" FontWeight="SemiBold"/>
                                    <Run Text=")" Foreground="Gray"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding LastBackupTime, StringFormat=上次: {0:MM-dd HH:mm}}"/>
                                            <Setter Property="Foreground" Value="#28A745"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastBackupTime}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="未備份"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4" Text="備份存放目錄:" Margin="0,5,0,5"/>
                <TextBox x:Name="TxtBackupDir" Grid.Row="5" Text="D:\SystemMigrator_Backups" Margin="0,0,0,15"/>
                <Button x:Name="BtnExecute" Grid.Row="6" Content="開始一鍵執行任務" Height="45" Background="#28A745" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnExecute_Click"/>
                
                <StackPanel Grid.Row="6" Margin="0,60,0,0">
                    <TextBlock x:Name="TxtOverallStatus" Text="總體進度" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <ProgressBar x:Name="PbOverall" Height="15" Background="#E0E0E0" Foreground="#28A745"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 右側：任務中心 (合併日誌) ================= -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/> 
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="2. 任務執行中心" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtGlobalStatus" Text="等待任務..." Foreground="#666" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 任務卡片列表 (包含專屬日誌與時間) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TasksItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 標題與狀態 -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusDisplayText}" HorizontalAlignment="Right" Foreground="#007ACC" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- 進度條 -->
                                        <ProgressBar Grid.Row="1" Height="10" Margin="0,10,0,5" Value="{Binding Progress}" Maximum="100" Foreground="#007ACC" Background="#E0E0E0"/>
                                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,10"/>

                                        <!-- 時間與日誌展開區 -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- 開始與完成時間 -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="開始: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding StartTime, StringFormat={}{0:HH:mm:ss}, FallbackValue=--:--:--}" FontSize="11" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                                <TextBlock Text="完成: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding EndTime, StringFormat={}{0:HH:mm:ss}, FallbackValue=--:--:--}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- 展開日誌按鈕 -->
                                            <Expander Grid.Column="1" Header="查看日誌" FontSize="11" Foreground="#007ACC" VerticalAlignment="Center">
                                                <Border Background="#1E1E1E" CornerRadius="5" Padding="10" Margin="0,10,0,0" MaxHeight="150">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Logs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,1" TextWrapping="Wrap">
                                                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="#6A9955"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding Message, Mode=OneWay}">
                                                                            <Run.Style>
                                                                                <Style TargetType="Run">
                                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                                            <Setter Property="Foreground" Value="#4EC9B0"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                                            <Setter Property="Foreground" Value="#888888"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Run.Style>
                                                                        </Run>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Expander>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>