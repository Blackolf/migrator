<Window x:Class="SystemMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SystemMigrator.Converters"
        xmlns:views="clr-namespace:SystemMigrator.Views"
        Width="1200"
        Height="850"
        Background="#F3F4F6"
        Title="系統遷移與淨化大師 V1.0.3"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <conv:SelectedCountConverter x:Key="SelectedCountConverter" />

    <!-- 分頁樣式 -->
    <Style TargetType="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder"
                    Background="Transparent"
                    CornerRadius="8,8,0,0"
                    Padding="18,8"
                    Margin="0,0,4,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#E5E7EB" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#007ACC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 整列即 label：點擊文字、空白、框框，都等同點擊 checkbox -->
    <Style x:Key="RowCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="RowBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 自繪 checkbox 外觀 -->
                            <Border x:Name="CheckBoxBorder"
                                    Grid.Column="0"
                                    Width="17" Height="17"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                    Data="M 2,6 L 6,10 L 12,2"
                                    Stroke="White"
                                    StrokeThickness="2.2"
                                    Stretch="None"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                            </Border>

                            <!-- 整列內容 (等同 HTML 的 label 文字) -->
                            <ContentPresenter Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2563EB"/>
                        </Trigger>

                        <!-- 勾選後：整列變色 + 框框變藍 + 打勾 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#E0F0FF"/>
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#BFDBFE"/>
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="#2563EB"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2563EB"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 備份區用綠色版本 -->
    <Style x:Key="RowCheckBoxStyleGreen" TargetType="CheckBox" BasedOn="{StaticResource RowCheckBoxStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="RowBorder" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="5" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder" Grid.Column="0" Width="17" Height="17"
                                    CornerRadius="4" Background="White" BorderBrush="#CBD5E1"
                                    BorderThickness="1.5" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 2,6 L 6,10 L 12,2"
                                    Stroke="White" StrokeThickness="2.2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#ECFDF5"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#16A34A"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#DCFCE7"/>
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#BBF7D0"/>
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="#16A34A"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#16A34A"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== 全域工具列：下載鏡像源 ==================== -->
    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="下載鏡像源" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#111827" />
        <ComboBox x:Name="CmbMirrorMode" Width="160" Margin="10,0,0,0"
                  SelectionChanged="CmbMirrorMode_SelectionChanged">
          <ComboBoxItem Content="自動（國內優先）" Tag="Auto" />
          <ComboBoxItem Content="僅官方源" Tag="Official" />
          <ComboBoxItem Content="僅國內鏡像" Tag="Domestic" />
        </ComboBox>
        <Button x:Name="BtnTestMirror" Content="測速" Width="64" Height="26" Margin="10,0,0,0"
                Click="BtnTestMirror_Click" />
        <TextBlock x:Name="TxtMirrorStatus" Margin="14,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="#6B7280" Text="鏡像設定載入中..." />
      </StackPanel>
    </Border>

    <!-- ==================== 分頁 ==================== -->
    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">

      <!-- ========== 頁 1：軟體與資料遷移（原有內容） ========== -->
      <TabItem Header="軟體與資料遷移">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- ================= 左側：掃描與選擇區 ================= -->
          <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- 標題列 -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="1. 掃描與選擇" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="BtnScan" Content="掃描系統" Width="100" Height="30"
                        Background="#007ACC" Foreground="White"
                        Click="BtnScan_Click" Margin="20,0,0,0"/>
              </StackPanel>

              <!-- 軟體工具列 -->
              <DockPanel Grid.Row="1" Margin="0,0,0,5">
                <TextBlock Text="已安裝軟體" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="全選" Width="55" Height="24" FontSize="11"
                          Click="BtnSelectAllApps_Click" Margin="0,0,5,0"/>
                  <Button Content="全不選" Width="55" Height="24" FontSize="11"
                          Click="BtnSelectNoneApps_Click"/>
                </StackPanel>
              </DockPanel>

              <!-- ★ 軟體列表：ItemsControl + ScrollViewer -->
              <ScrollViewer x:Name="AppScroll" Grid.Row="2"
                            VerticalScrollBarVisibility="Visible"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,4,0">
                <ItemsControl x:Name="LstApps" BorderThickness="0">
                  <ItemsControl.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type GroupItem}">
                                <Expander IsExpanded="True" Margin="0,0,0,5">
                                  <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                 Foreground="#007ACC" FontSize="13"/>
                                      <TextBlock Foreground="Gray" FontSize="12" Margin="6,0,0,0">
                                        <Run Text="("/>
                                        <Run Text="{Binding Items, Converter={StaticResource SelectedCountConverter}, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                      </TextBlock>
                                    </StackPanel>
                                  </Expander.Header>
                                  <ItemsPresenter Margin="0,4,0,0"/>
                                </Expander>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ItemsControl.GroupStyle>

                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- 整列就是一個 CheckBox，點哪都 toggle -->
                      <CheckBox Style="{StaticResource RowCheckBoxStyle}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Margin="0,0,0,2">
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                          <TextBlock Text="{Binding InstallLocation}" FontSize="10"
                                     Foreground="#94A3B8" Margin="0,2,0,0"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- 備份工具列 -->
              <DockPanel Grid.Row="3" Margin="0,10,0,5">
                <TextBlock Text="數據備份 / 還原" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="全選" Width="55" Height="24" FontSize="11"
                          Click="BtnSelectAllBackups_Click" Margin="0,0,5,0"/>
                  <Button Content="全不選" Width="55" Height="24" FontSize="11"
                          Click="BtnSelectNoneBackups_Click"/>
                </StackPanel>
              </DockPanel>

              <!-- ★ 備份列表：ItemsControl + ScrollViewer -->
              <ScrollViewer x:Name="BackupScroll" Grid.Row="4"
                            VerticalScrollBarVisibility="Visible"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,4,0">
                <ItemsControl x:Name="LstBackups" BorderThickness="0">
                  <ItemsControl.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type GroupItem}">
                                <Expander IsExpanded="True" Margin="0,0,0,5">
                                  <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                 Foreground="#16A34A" FontSize="13"/>
                                      <TextBlock Foreground="Gray" FontSize="12" Margin="6,0,0,0">
                                        <Run Text="("/>
                                        <Run Text="{Binding Items, Converter={StaticResource SelectedCountConverter}, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                      </TextBlock>
                                    </StackPanel>
                                  </Expander.Header>
                                  <ItemsPresenter Margin="0,4,0,0"/>
                                </Expander>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ItemsControl.GroupStyle>

                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Style="{StaticResource RowCheckBoxStyleGreen}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Margin="0,0,0,2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13">
                              <Run Text="{Binding Name, Mode=OneWay}"/>
                              <Run Text="(" Foreground="Gray"/>
                              <Run Text="{Binding SizeInMB, StringFormat={}{0:F1} MB, Mode=OneWay}"
                                   Foreground="#16A34A" FontWeight="SemiBold"/>
                              <Run Text=")" Foreground="Gray"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SourcePath}" FontSize="10"
                                       Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding LastBackupTime, StringFormat=上次: {0:MM-dd HH:mm}}"/>
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding LastBackupTime}" Value="{x:Null}">
                                    <Setter Property="Text" Value="未備份"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- 底部 -->
              <TextBlock Grid.Row="5" Text="備份存放目錄:" Margin="0,12,0,5"/>
              <TextBox x:Name="TxtBackupDir" Grid.Row="6" Text="D:\SystemMigrator_Backups"
                       Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
              <Button x:Name="BtnExecute" Grid.Row="7" Content="開始一鍵執行任務" Height="45"
                      Background="#28A745" Foreground="White" FontSize="16" FontWeight="Bold"
                      Click="BtnExecute_Click"/>
              <StackPanel Grid.Row="8" Margin="0,12,0,0">
                <TextBlock x:Name="TxtOverallStatus" Text="總體進度" FontSize="12"
                           Foreground="#666" Margin="0,0,0,5"/>
                <ProgressBar x:Name="PbOverall" Height="15" Background="#E0E0E0" Foreground="#28A745"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ================= 右側：任務中心 (合併日誌) ================= -->
          <Border Background="White" CornerRadius="10" Padding="15" Grid.Column="2">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,10" Grid.Row="0">
                <TextBlock FontSize="18" FontWeight="Bold" Text="2. 任務執行中心" />
                <TextBlock x:Name="TxtGlobalStatus"
                           Margin="0,5,0,0"
                           Foreground="#666"
                           Text="等待任務..." />
              </StackPanel>
              <!-- 任務卡片列表 (包含專屬日誌與時間) -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                <ItemsControl x:Name="TasksItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,15"
                              Background="#F9FAFB"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="15">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <!-- 標題與狀態 -->
                          <Grid Grid.Row="0">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding Name}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#007ACC"
                                       Text="{Binding StatusDisplayText}" />
                          </Grid>
                          <!-- 進度條 -->
                          <ProgressBar Height="10"
                                       Margin="0,10,0,5"
                                       Background="#E0E0E0"
                                       Foreground="#007ACC"
                                       Maximum="100"
                                       Value="{Binding Progress}"
                                       Grid.Row="1" />
                          <TextBlock Margin="0,0,0,10"
                                     FontSize="12"
                                     Foreground="#6B7280"
                                     Text="{Binding StatusText}"
                                     Grid.Row="2" />
                          <!-- 時間與日誌展開區 -->
                          <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 開始與完成時間 -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                              <TextBlock FontSize="11" Foreground="Gray" Text="開始: " />
                              <TextBlock Margin="0,0,15,0"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Text="{Binding StartTime, StringFormat={}{0:HH:mm:ss}, FallbackValue=--:--:--}" />
                              <TextBlock FontSize="11" Foreground="Gray" Text="完成: " />
                              <TextBlock FontSize="11"
                                         FontWeight="SemiBold"
                                         Text="{Binding EndTime, StringFormat={}{0:HH:mm:ss}, FallbackValue=--:--:--}" />
                            </StackPanel>
                            <!-- 展開日誌按鈕 -->
                            <Expander VerticalAlignment="Center"
                                      FontSize="11"
                                      Foreground="#007ACC"
                                      Header="查看日誌"
                                      Grid.Column="1">
                              <Border Margin="0,10,0,0"
                                      Background="#1E1E1E"
                                      CornerRadius="5"
                                      MaxHeight="150"
                                      Padding="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                  <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Margin="0,1"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   TextWrapping="Wrap">
                                          <Run Foreground="#6A9955" Text="{Binding Time, Mode=OneWay}" />
                                          <Run Text=" " />
                                          <Run Text="{Binding Message, Mode=OneWay}">
                                            <Run.Style>
                                              <Style TargetType="Run">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="#4EC9B0" />
                                                  </DataTrigger>
                                                  <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </Run.Style>
                                          </Run>
                                        </TextBlock>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </ScrollViewer>
                              </Border>
                            </Expander>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ========== 頁 2：分區備份與安裝 ========== -->
      <TabItem Header="分區備份與安裝">
        <views:PartitionPage />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
